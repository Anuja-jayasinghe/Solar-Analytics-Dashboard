# Environment variables for Solar Analytics Dashboard
#
# Vercel → Project → Settings → Environment Variables (Production, and Preview if desired).
# For local development, copy the relevant lines into a `.env` file at the repo root.
#
# VITE_* variables are compiled into the browser bundle and are PUBLIC. Never put a secret
# behind a VITE_ prefix. Everything else is server-side only.

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — server side
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-id>.supabase.co

# MUST be the service_role (secret) key, not the anon key.
#
# A service_role key bypasses RLS; an anon key does not. This exact mix-up took inverter data
# collection down — every insert was silently rejected with "new row violates row-level
# security policy" for five months. If you see that error, this is why.
# Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_KEY=<service-role-secret-key>

# Storage bucket holding uploaded CEB bill PDFs. Defaults to `ceb_bills` if unset.
SUPABASE_STORAGE_BUCKET_BILLS=ceb_bills

# ─────────────────────────────────────────────────────────────────────────────
# Clerk — authentication
# ─────────────────────────────────────────────────────────────────────────────
# Server side. Used by api/middleware/verifyAdminToken.js to authorize every endpoint.
CLERK_SECRET_KEY=<clerk-secret-key>

# Optional. Comma-separated origins allowed to mint tokens this API will accept — a replay
# guard. Defaults to the production domain plus localhost dev ports.
# CLERK_AUTHORIZED_PARTIES=https://solaredge.anujajay.com,http://localhost:5173

# Client side (public).
VITE_CLERK_PUBLISHABLE_KEY=<clerk-publishable-key>

# Must be 'true' for the Clerk auth path. Anything else falls back to the legacy Supabase
# auth adapter, which is no longer maintained.
VITE_USE_CLERK_AUTH=true

# Optional. Name of a Clerk JWT template, if one is configured. When set, the admin screens
# request tokens from that template instead of the default session token.
# VITE_CLERK_JWT_TEMPLATE_NAME=<template-name>

# ─────────────────────────────────────────────────────────────────────────────
# SolisCloud — server side
# ─────────────────────────────────────────────────────────────────────────────
SOLIS_API_URL=https://www.soliscloud.com:13333
SOLIS_API_ID=<solis-api-id>
SOLIS_API_SECRET=<solis-api-secret>

# ─────────────────────────────────────────────────────────────────────────────
# API
# ─────────────────────────────────────────────────────────────────────────────
# Optional. Comma-separated CORS allowlist. Defaults to the production domain, localhost dev
# ports, and this project's Vercel preview deployments. Setting it REPLACES those defaults.
# ALLOWED_ORIGINS=https://solaredge.anujajay.com

# ─────────────────────────────────────────────────────────────────────────────
# Client (Vite) — all PUBLIC
# ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://<project-id>.supabase.co

# The anon/publishable key. Public by design — it ships in the JS bundle. It can only read;
# every write goes through an admin-authenticated API endpoint.
VITE_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Optional table/schema overrides. Defaults shown.
# VITE_SUPABASE_SCHEMA=public
# VITE_SUPABASE_TABLE_CEB=ceb_data
# VITE_SUPABASE_TABLE_INVERTER=inverter_data

# ─────────────────────────────────────────────────────────────────────────────
# Feature flags
# ─────────────────────────────────────────────────────────────────────────────
VITE_ENABLE_DEVTOOLS=true
VITE_SHOW_COMING_SOON=false

# Renders the dashboard against static demo data instead of live Supabase data.
# VITE_DEMO_TEST_MODE=false

# ─────────────────────────────────────────────────────────────────────────────
# GitHub Actions
# ─────────────────────────────────────────────────────────────────────────────
# The scheduled workflows read the same names as repo secrets:
#   SUPABASE_URL, SUPABASE_SERVICE_KEY, SOLIS_API_URL, SOLIS_API_ID, SOLIS_API_SECRET
# Set with: gh secret set <NAME>
